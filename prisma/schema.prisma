generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  ADMIN
}

enum SourceType {
  EXPLICIT_PAGE
  PARENT_WITH_DESCENDANTS
  LABEL
}

enum SourceStatus {
  PENDING
  SYNCED
  UNCHANGED
  CHANGED
  FAILED
  UNAVAILABLE
  DISABLED
}

enum SyncRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SyncTriggerType {
  CRON
  MANUAL
  SINGLE_SOURCE
  RETRY
}

enum SyncItemStatus {
  ADDED
  UPDATED
  UNCHANGED
  REMOVED
  FAILED
  SKIPPED
}

enum FeedbackHelpful {
  HELPFUL
  NOT_HELPFUL
  INCORRECT
}

enum FeedbackReviewStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum AuditEventType {
  SOURCE_CREATED
  SOURCE_UPDATED
  SOURCE_DELETED
  SOURCE_ENABLED
  SOURCE_DISABLED
  SYNC_TRIGGERED
  SYNC_COMPLETED
  SYNC_FAILED
  USER_LOGIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          UserRole  @default(STAFF)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  feedback      AnswerFeedback[]
  syncRuns      SyncRun[]      @relation("SyncRunTriggeredBy")
  auditEvents   AuditEvent[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  feedback AnswerFeedback[]

  @@index([userId, updatedAt(sort: Desc)])
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String
  role             String
  content          String   @db.Text
  openaiResponseId String?
  model            String?
  latencyMs        Int?
  retrievalCount   Int      @default(0)
  createdAt        DateTime @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    MessageCitation[]
  feedback     AnswerFeedback[]

  @@index([conversationId, createdAt])
}

model MessageCitation {
  id                 String   @id @default(cuid())
  messageId          String
  knowledgeSourceId  String?
  openaiFileId       String?
  title              String
  sourceUrl          String
  confluencePageId   String?
  spaceKey           String?
  confluenceUpdatedAt DateTime?
  createdAt          DateTime @default(now())

  message         Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([knowledgeSourceId])
}

model KnowledgeSource {
  id                    String       @id @default(cuid())
  confluencePageId      String
  sourceUrl             String
  title                 String
  spaceId               String?
  spaceKey              String?
  sourceType            SourceType   @default(EXPLICIT_PAGE)
  category              String?
  audience              String?
  classification        String?
  enabled               Boolean      @default(true)
  includeDescendants    Boolean      @default(false)
  labelName             String?
  lastKnownVersion      Int?
  lastKnownUpdatedAt    DateTime?
  contentHash           String?
  openaiFileId          String?
  lastSuccessfulSyncAt  DateTime?
  lastAttemptedSyncAt   DateTime?
  status                SourceStatus @default(PENDING)
  lastError             String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  files      KnowledgeFile[]
  syncItems  SyncItem[]
  citations  MessageCitation[]

  @@unique([confluencePageId, sourceType])
  @@index([enabled, status])
  @@index([sourceType])
}

model KnowledgeFile {
  id                String   @id @default(cuid())
  knowledgeSourceId String
  openaiFileId      String
  contentHash       String
  version           Int?
  indexedAt         DateTime @default(now())
  replacedAt        DateTime?
  isActive          Boolean  @default(true)

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([knowledgeSourceId, isActive])
  @@index([openaiFileId])
}

model SyncRun {
  id              String          @id @default(cuid())
  status          SyncRunStatus   @default(PENDING)
  triggerType     SyncTriggerType
  triggeredById   String?
  dryRun          Boolean         @default(false)
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  addedCount      Int             @default(0)
  updatedCount    Int             @default(0)
  unchangedCount  Int             @default(0)
  removedCount    Int             @default(0)
  failedCount     Int             @default(0)
  errorSummary    String?         @db.Text
  lockAcquired    Boolean         @default(false)

  triggeredBy User?      @relation("SyncRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  items       SyncItem[]

  @@index([startedAt(sort: Desc)])
  @@index([status])
}

model SyncItem {
  id                String         @id @default(cuid())
  syncRunId         String
  knowledgeSourceId String
  status            SyncItemStatus
  message           String?        @db.Text
  previousFileId    String?
  newFileId         String?
  createdAt         DateTime       @default(now())

  syncRun         SyncRun         @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([knowledgeSourceId])
}

model AnswerFeedback {
  id                    String               @id @default(cuid())
  userId                String
  conversationId        String
  messageId             String
  helpful               FeedbackHelpful
  reason                String?
  comments              String?              @db.Text
  suggestsDocumentationGap Boolean           @default(false)
  reviewStatus          FeedbackReviewStatus @default(OPEN)
  createdAt             DateTime             @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([helpful, reviewStatus])
  @@index([userId])
}

model AuditEvent {
  id         String         @id @default(cuid())
  type       AuditEventType
  userId     String?
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([type])
}

model SyncLock {
  id        String   @id @default("global")
  lockedAt  DateTime?
  syncRunId String?
  updatedAt DateTime @updatedAt
}
