# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Supabase — Project Settings → API)
# Never expose the service-role key to browser code.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Authentication
AUTH_SECRET=replace-with-a-secure-random-string-at-least-32-characters
LOCAL_AUTH_ENABLED=true
LOCAL_MOCK_MODE=true

# Microsoft Entra ID (optional; auth is currently bypassed in development)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VECTOR_STORE_ID=

# Public Confluence Cloud site (anonymous REST access only)
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net

# Scheduled sync protection
CRON_SECRET=replace-with-a-secure-cron-secret

# Rate limiting (requests per minute)
CHAT_RATE_LIMIT=20
SYNC_RATE_LIMIT=5
