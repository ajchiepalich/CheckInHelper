# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://highlands:highlands_dev@localhost:5432/highlands_docs

# Authentication
AUTH_SECRET=replace-with-a-secure-random-string-at-least-32-characters
LOCAL_AUTH_ENABLED=true
LOCAL_MOCK_MODE=true

# Microsoft Entra ID (leave empty for local development mode)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VECTOR_STORE_ID=

# Atlassian Confluence Cloud
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_USER_EMAIL=
ATLASSIAN_API_TOKEN=

# Scheduled sync protection
CRON_SECRET=replace-with-a-secure-cron-secret

# Rate limiting (requests per minute)
CHAT_RATE_LIMIT=20
SYNC_RATE_LIMIT=5
